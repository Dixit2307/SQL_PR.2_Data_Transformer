-- SQLBook: Markup
### Q - 14 Calculate the running total of Total Amount For each order
-- SQLBook: Code
SELECT 
    Order_id, 
    Total_amount,
    SUM(Total_amount) OVER(ORDER BY Order_date, Order_id) AS Running_total
FROM `Order`;
-- SQLBook: Markup
### Q - 15 Rank order based on Total Amount using the RANK() Function 
-- SQLBook: Code
SELECT 
    Order_id, 
    Total_amount,
    RANK() OVER(ORDER BY Total_amount DESC) AS OrderRank
FROM `Order`;
-- SQLBook: Markup
### Q - 16 Assign a discount based on Total Amount in Order
-- SQLBook: Code
SELECT 
    Order_id,
    Customer_id,
    Order_date,
    Total_amount,
    CASE 
        WHEN Total_amount >= 900 THEN '15% Discount'
        WHEN Total_amount >= 500  THEN '10% Discount'
        WHEN Total_amount >= 100  THEN '5% Discount'
        ELSE 'No Discount'
    END AS Discount_Persentage
FROM `Order`;
-- SQLBook: Markup
### Q - 17 Categorize employees salaries as high . medium or Low.
-- SQLBook: Code
SELECT Employee_id ,
    First_name ,
    Last_name ,
    Salary,           
    CASE 
        WHEN Salary <= 50000 THEN 'Low'
        WHEN Salary <= 75000 THEN 'Medium'
        ELSE 'High'
    END AS Salary_Level
FROM employees;
