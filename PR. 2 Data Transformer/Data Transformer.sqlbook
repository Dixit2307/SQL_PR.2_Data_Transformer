### Q - 1 INNER JOIN - Retrive all order and customer details Where Oredr Exist.
-- SQLBook: Code
SELECT o.Order_id, o.Order_date, o.Total_amount, c.Customer_id, c.First_name, c.Last_name
FROM `Order` o
INNER JOIN Customers c ON o.Customer_id = c.Customer_id;

-- SQLBook: Markup
### Q - 2 LEFT JOIN - Retrive all customers and Thire correcpanding Orders (If Any).            

-- SQLBook: Code
SELECT c.Customer_id, c.First_name, c.Last_name, o.Order_id, o.Order_date, o.Total_amount
FROM Customers c
LEFT JOIN `Order` o ON c.Customer_id = o.Customer_id;

-- SQLBook: Markup
### Q - 3 RIGHT JOIN - Retrive all Order and thire corresponding customers (if any).
-- SQLBook: Code
SELECT o.Order_id, o.Order_date, o.Total_amount, c.Customer_id, c.First_name, c.Last_name
FROM `Order` o
RIGHT JOIN Customers c ON o.Customer_id = c.Customer_id;
  
-- SQLBook: Markup
### Q - 4 FULL OUTER JOIN - Retrive all customers and all orders, regardless of matching.
-- SQLBook: Code
SELECT c.Customer_id, c.First_name, c.Last_name, o.Order_id, o.Order_date, o.Total_amount
FROM Customers c
LEFT JOIN `Order` o ON c.Customer_id = o.Customer_id

UNION

SELECT c.Customer_id, c.First_name, c.Last_name, o.Order_id, o.Order_date, o.Total_amount
FROM Customers c
RIGHT JOIN `Order` o ON c.Customer_id = o.Customer_id;

-- SQLBook: Markup
### Q - 5 Subquery to find customers who have placed orders Worth more than Average Amount

-- SQLBook: Code
SELECT * FROM Customers
WHERE Customer_id IN (
    SELECT Customer_id FROM `Order` 
    WHERE Total_amount > (SELECT AVG(Total_amount) FROM `Order`)
);
-- SQLBook: Markup
### Q - 6  Subquery to find Employees with salaries above the average Salary.
-- SQLBook: Code
SELECT Employee_id , First_name , Last_name , Department , Total_salary
FROM Employees
WHERE Total_salary >= AVG(Total_salary)
FROM Employees;
-- SQLBook: Markup
### Q - 7 Extract the year and Month from the Order Date
-- SQLBook: Code
SELECT 
    YEAR(Order_date) AS Order_Year,
    MONTH(Order_date) AS Order_Month
FROM `Order`;
-- SQLBook: Markup
### Q - 8 Calculate the differebce in days between two date
-- SQLBook: Code
SELECT 
    Order_date,
    DATEDIFF(CURDATE(), Order_date) AS Days_deffrience
FROM `Order`;
-- SQLBook: Markup
###  Q - 9 Format the Orderdate to a more readable format (DD-MM-YYYY)
-- SQLBook: Code
SELECT 
    DATE_FORMAT(Order_date, '%d-%m-%Y') AS Formated_date
FROM `Order`;
-- SQLBook: Markup
### Q - 10 Convert FirstName and LastName to form a fullname
-- SQLBook: Code
SELECT 
    TRIM(First_name) AS CleanedFirst,
    TRIM(Last_name) AS CleanedLast,
    CONCAT(TRIM(First_name), ' ', TRIM(Last_name)) AS Full_name
FROM Employees;
-- SQLBook: Markup
